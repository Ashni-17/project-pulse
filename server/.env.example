# ==========================================
# PROJECT PULSE - Environment Configuration
# ==========================================
# Copy this file to .env and configure values.
# Never commit the actual .env file.

# ------------------------------------------
# 1. Server Configuration
# ------------------------------------------
PORT=4000
NODE_ENV=development
SERVER_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# ------------------------------------------
# 2. PostgreSQL Database (Required)
# ------------------------------------------
# Replace username, password and port as needed.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/project_pulse

# ------------------------------------------
# 3. JWT Authentication (Required)
# ------------------------------------------
# Use a strong, randomly generated secret.
JWT_SECRET=replace-with-a-long-random-secret

# ------------------------------------------
# 4. Email / SMTP Configuration
# Required for OTP registration and recovery.
# ------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Project Pulse <your-email@gmail.com>"

# ------------------------------------------
# 5. Google OAuth (Optional)
# Required only for Google sign-in.
# ------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ------------------------------------------
# 6. Gemini AI (Optional)
# Required only for Pulse AI features.
# ------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=15000